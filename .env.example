# ==============================================================================
# SaaS Revenue Assurance: Environment Configuration
# Contract-to-Cash & Customer Unit Economics Auditor
# ==============================================================================

# Database Connection
# Dual-database compatibility: Leave empty or omit to use zero-config SQLite (./saas_assurance.db)
# Or provide PostgreSQL connection string for production deployment:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_assurance
DATABASE_URL=sqlite:///./saas_assurance.db

# Security & Authentication (JWT)
SECRET_KEY=saas-revenue-assurance-super-secure-production-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI & LLM Engine (Google Gemini API)
# Optional: Assistant uses database-grounded parameterized analytical tools by default.
# Configure key to enable Gemini 1.5 Pro natural-language reasoning.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Server Configuration
ENVIRONMENT=development
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Financial & Anomaly Engine Defaults
DEFAULT_CURRENCY=₹
UNDERBILLING_THRESHOLD=5000
OVERBILLING_THRESHOLD=5000
PRICING_MISMATCH_PCT_THRESHOLD=5.0
CRITICAL_SEVERITY_THRESHOLD=100000
