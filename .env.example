# Copy to .env (git-ignored) and fill in. Never commit real secrets.
ENVIRONMENT=development

# PostgreSQL (docker compose provides one on localhost:5432)
DATABASE_URL=postgresql+psycopg://sra:change-me@localhost:5432/sra
POSTGRES_USER=sra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sra

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5185,http://127.0.0.1:5185
SESSION_IDLE_MINUTES=60            # signed out after this long without activity
LOGIN_MAX_ATTEMPTS_PER_MINUTE=10   # per account (3x this per client address); shared via the database
APP_BASE_URL=http://localhost:5185 # used in password-reset links
PASSWORD_RESET_MINUTES=60

# Optional public read-only demo: a "View the demo" button on the sign-in page signs in as this account.
# It must be an active VIEWER (the server refuses any other role). Leave empty to hide the button.
DEMO_LOGIN_EMAIL=
# Demo mode: with DEMO_LOGIN_EMAIL set, visitors open the read-only demo straight away (no sign-in step).
# The banner's "Sign in with your account" (or /?signin) shows the normal sign-in form.
DEMO_AUTO_LOGIN=false

# Optional email, enables self-service "Forgot password". Without it, admins issue one-time reset links
# (Settings -> Users -> Reset link). EMAIL_PROVIDER: smtp | brevo (HTTPS API, free tier: 300 emails/day).
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
BREVO_API_KEY=

# First admin account (created only when the database has no users).
# Leave the password empty to have a one-time password printed to the server console.
BOOTSTRAP_ADMIN_EMAIL=admin@demo.local
BOOTSTRAP_ADMIN_PASSWORD=

# Demo data and start-up behaviour
SEED_DEMO_DATA_ON_START=true   # false for a real workspace: start empty and use the Get started guide
AUTO_MIGRATE=true              # false in production: run `alembic -c backend/alembic.ini upgrade head` when deploying
AUDIT_STALE_MINUTES=15         # QUEUED/RUNNING audits with no progress for this long are marked FAILED

# Scheduled work: the daily job (/api/v1/cron/daily) needs "Authorization: Bearer $CRON_SECRET".
# Vercel Cron sends it automatically when CRON_SECRET is set. Empty = endpoint disabled.
CRON_SECRET=
AUTO_MONTHLY_AUDIT=true        # audit last month automatically once it has closed
AUTO_AUDIT_DAY=2               # earliest day of the month for that audit

# Optional error monitoring (Sentry, free Developer plan). Browser events go through /api/v1/monitoring/sentry-tunnel.
SENTRY_DSN=
SENTRY_FRONTEND_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Shown on the public /privacy and /terms pages
OPERATOR_NAME=
CONTACT_EMAIL=

# Hosting
AUDIT_EXECUTION=background     # inline on serverless hosts (Vercel): finish the audit before responding
DB_POOL_MODE=queue             # null on serverless hosts: one connection per request, nothing kept between requests
SERVE_FRONTEND=true            # serve frontend/dist from the API process when it has been built
# Optional: password for the demo users created by `python -m backend.app.seed.cli`
DEMO_USER_PASSWORD=

# GenAI (Phase 11; not required for any financial calculation)
# Optional. Leave empty to use the built-in deterministic analysis engine (default).
# Set LLM_PROVIDER=anthropic plus a key and model to let a language model plan the read-only tool calls.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
