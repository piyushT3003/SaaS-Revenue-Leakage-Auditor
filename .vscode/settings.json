{
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/Scripts/python.exe",
  "python.envFile": "${workspaceFolder}/.vscode/test.env",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["backend/tests"],
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "files.exclude": { "**/__pycache__": true, ".pytest_cache": true, ".localdb": true, ".pgenv": true },
  "search.exclude": { "**/node_modules": true, "frontend/dist": true, ".localdb": true, ".pgenv": true, "_legacy_backup": true },
  "files.watcherExclude": { "**/.localdb/**": true, "**/.pgenv/**": true, "**/node_modules/**": true }
}
